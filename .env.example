# Copy this file to .env and fill in your own values.
# Never commit your actual .env file — it's already in .gitignore.

# From console.anthropic.com
ANTHROPIC_API_KEY=

# From Robinhood's Agentic Trading setup flow:
# robinhood.com/us/en/support/agentic-trading
ROBINHOOD_MCP_URL=
ROBINHOOD_ACCOUNT_NUMBER=

# OAuth client_id registered via dynamic client registration against
# https://agent.robinhood.com/oauth/trading/register (see src/oauth.py).
# There is no client secret — this server issues public clients only.
# After setting this, run `python scripts/oauth_login.py` once to obtain
# and store access/refresh tokens (see oauth.DEFAULT_TOKENS_PATH);
# ROBINHOOD_CLIENT_ID alone is not enough to authenticate.
ROBINHOOD_CLIENT_ID=
